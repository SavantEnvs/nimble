project: savantenvs/nimble
# In-process libFuzzer harness (mayhem/fuzz_encoding.cpp): the input is one encoded stream (a
# single, possibly nested, Nimble encoding), built with nimble::EncodingFactory and materialized.
target: fuzz_encoding

cmds:
  - cmd: /mayhem/fuzz_encoding
    libfuzzer: true
    timeout: 10
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/fuzz_encoding/testsuite
